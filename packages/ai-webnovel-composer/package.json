{
  "name": "@ai-webnovel/composer",
  "version": "0.1.0",
  "description": "Profile bundle for the AI Web Novel Composer: the patch layer that inserts the composer plugin into a DSH profile",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node --check index.js",
    "typecheck": "node --check index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-webnovel/composer-host": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.11",
    "yaml": "^2.9.1"
  }
}
